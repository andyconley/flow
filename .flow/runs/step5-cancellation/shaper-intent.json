{
  "problem": "An operator cannot stop a live v8 delivery attempt or recover a stuck one without Python; an attempt with an unknown send and no stored response makes its work id unrecoverable.",
  "intended_users": [
    "Andy, Flow's sole operator.",
    "The Shaper, acting through the same CLI with attribution-only identity."
  ],
  "outcomes": [
    "Cancel a live v8 attempt, abandon a stuck one, find stuck attempts, and continue the same work id with a successor, keeping uncertainty honest and never resending."
  ],
  "scope": [
    "Process identity record, cooperative cancel in the parent, cancel-delivery, abandon-delivery, cancelled/abandoned receipt seals, uncertainty scoping, successor lineage, delivery-lead CLI, inspect-delivery and flow run stuck, ADR 0019."
  ],
  "exclusions": [
    "Protocols 5-7.",
    "Charter-sealed automatic cancel.",
    "MCP ingress.",
    "Actor authentication.",
    "resolve-execution changes.",
    "Runtime-cap behaviour change.",
    "Cross-machine cancel.",
    "Non-POSIX.",
    "Ollama server-side generation.",
    "SIGINT semantics.",
    "Live provider runs."
  ],
  "constraints": [
    "The ledger and existing fences stay authoritative.",
    "Uncertain rows are never resent or reclassified without evidence.",
    "No backwards-compatibility work.",
    "Hermetic tests only."
  ],
  "assumptions": [
    "The parent holds recovery_lock for the whole v8 attempt.",
    "Provider and supervisor waits retry on EINTR, so interruption must be explicit."

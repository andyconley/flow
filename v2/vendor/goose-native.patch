+//! Explicit native permission/scope errors that must cross coordinator boundaries.
+use serde_json::{json, Value};
+
+pub(crate) const PREFIX: &str = "GLG_NATIVE_BOUNDARY:";
+
+pub(crate) fn from_output(output: Option<&Value>, tool_call_id: &str) -> Option<String> {
+    let original = output?;
+    let boundary = original.get("goose.native.boundary")?;
+    let kind = boundary.get("kind")?.as_str()?;
+    if !matches!(kind, "permission_required" | "scope_required") {
+        return None;
+    }
+    boundary.get("message")?.as_str()?;
+    boundary.get("code")?.as_str()?;
+    Some(format!(
+        "{PREFIX}{}",
+        json!({
+            "schema_version": 1, "kind": kind, "source": "acp_tool",
+            "tool_call_id": tool_call_id, "error": boundary, "original_output": original,
+        })
+    ))
+}
+
+pub(crate) fn denial(tool_call_id: &str) -> String {
+    format!(
+        "{PREFIX}{}",
+        json!({"schema_version": 1,
+            "kind": "permission_required", "source": "acp_permission_decision",
+            "tool_call_id": tool_call_id,
+            "error": {"code": "permission_rejected", "message": "ACP permission decision rejected the requested action"},
+        })
+    )
+}
+
+pub(crate) fn is_boundary(reason: &str) -> bool {
+    let Some((_, payload)) = reason.split_once(PREFIX) else {
+        return false;
+    };
+    let Some(Ok(value)) = serde_json::Deserializer::from_str(payload)
+        .into_iter::<Value>()
+        .next()
+    else {
+        return false;
+    };
+    value["schema_version"] == 1
+        && matches!(
+            value["kind"].as_str(),
+            Some("permission_required" | "scope_required")
+        )
+        && value["error"].is_object()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn explicit_permission_and_scope_keep_original_error() {
+        for kind in ["permission_required", "scope_required"] {
+            let raw = json!({"goose.native.boundary": {"kind":kind,"code":"EPERM","message":"PermissionError: [Errno 1] Operation not permitted: pyvenv.cfg"},"exit_code":1});
+            let error = from_output(Some(&raw), "tool-42").unwrap();
+            let value: Value = serde_json::from_str(error.strip_prefix(PREFIX).unwrap()).unwrap();
+            assert_eq!(value["kind"], kind);
+            assert_eq!(value["original_output"], raw);
+            assert_eq!(value["tool_call_id"], "tool-42");
+        }
+    }
+    #[test]
+    fn missing_or_generic_failure_is_not_permission_evidence() {
+        for raw in [
+            json!({}),
+            json!({"exit_code":1}),
+            json!({"message":"permission may be missing"}),
+        ] {
+            assert!(from_output(Some(&raw), "tool").is_none());
+        }
+        assert!(from_output(None, "tool").is_none());
+        assert!(is_boundary(&denial("tool")));
+        assert!(!is_boundary("generic GLG_NATIVE_BOUNDARY:unknown"));
+    }
+}

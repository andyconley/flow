@@ -0,0 +1,110 @@
+use async_trait::async_trait;
+use goose_agent::inference::{InferenceEffect, InferenceRunner};
+use goose_agent::operation::{Emitter, Inference, InferenceInput, OperationResult};
+use goose_provider_types::base::{
+    MessageStream, NativeTurnEvidence, Provider, ProviderEvent, ProviderEventStream,
+};
+use goose_provider_types::conversation::{
+    message::Message, token_usage::ProviderUsage, Conversation,
+};
+use goose_provider_types::errors::ProviderError;
+use goose_provider_types::model::ModelConfig;
+use std::sync::{Arc, Mutex};
+
+struct Fixture(Mutex<Option<Vec<Result<ProviderEvent, ProviderError>>>>);
+#[async_trait]
+impl Provider for Fixture {
+    fn get_name(&self) -> &str {
+        "native-fixture"
+    }
+    fn supports_native_completion(&self) -> bool {
+        true
+    }
+    async fn stream(
+        &self,
+        _: &ModelConfig,
+        _: &str,
+        _: &[Message],
+        _: &[rmcp::model::Tool],
+    ) -> Result<MessageStream, ProviderError> {
+        unreachable!()
+    }
+    async fn stream_events(
+        &self,
+        _: &ModelConfig,
+        _: &str,
+        _: &[Message],
+        _: &[rmcp::model::Tool],
+    ) -> Result<ProviderEventStream, ProviderError> {
+        Ok(Box::pin(futures::stream::iter(
+            self.0.lock().unwrap().take().unwrap(),
+        )))
+    }
+}
+enum Effect {
+    Message,
+    Usage,
+    Terminal(NativeTurnEvidence),
+}
+impl From<Message> for Effect {
+    fn from(_: Message) -> Self {
+        Self::Message
+    }
+}
+impl InferenceEffect for Effect {
+    fn record_usage(_: ProviderUsage) -> Self {
+        Self::Usage
+    }
+    fn native_terminal(e: NativeTurnEvidence) -> Option<Self> {
+        Some(Self::Terminal(e))
+    }
+}
+fn terminal() -> ProviderEvent {
+    ProviderEvent::NativeTerminal(NativeTurnEvidence {
+        attempt_id: "attempt".into(),
+        provider_session_id: "session".into(),
+        stop_reason: "end_turn".into(),
+        final_text: "{}".into(),
+        tool_error: false,
+        pending_tools: false,
+        final_message_id: None,
+        final_message_phase: None,
+        tool_observation: goose_provider_types::base::NativeToolObservation::ObservedSuccess,
+    })
+}
+
+#[tokio::test]
+async fn native_terminal_cannot_hide_later_error_or_duplicate_or_content() {
+    for (last, expected) in [
+        (
+            Err(ProviderError::RequestFailed("transport broke".into())),
+            "stream_error",
+        ),
+        (Ok(terminal()), "duplicate_terminal"),
+        (
+            Ok(ProviderEvent::Chunk(
+                Some(Message::assistant().with_text("late")),
+                None,
+            )),
+            "post_terminal_update",
+        ),
+    ] {
+        let provider = Arc::new(Fixture(Mutex::new(Some(vec![Ok(terminal()), last]))));
+        let runner = InferenceRunner::<(), Effect>::new(provider, ModelConfig::new("fixture"));
+        let conversation = Conversation::new_unvalidated([Message::user().with_text("task")]);
+        let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+        let emit = Emitter::new(tx, tokio_util::sync::CancellationToken::new());
+        let result = runner
+            .infer(&(), &conversation, InferenceInput::default(), &emit)
+            .await
+            .unwrap();
+        let OperationResult::Applied(step) = result else {
+            panic!("applied inference expected")
+        };
+        let reason = step.effects.into_iter().find_map(|effect| match effect {
+            Effect::Terminal(e) => Some(e.stop_reason),
+            _ => None,
+        });
+        assert_eq!(reason.as_deref(), Some(expected));
+    }
+}

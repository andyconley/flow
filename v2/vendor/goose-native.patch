+#[tokio::test]
+async fn native_completion_actual_adapter_transport_contract_matrix() {
+    let fixture: serde_json::Value =
+        serde_json::from_str(include_str!("../../tests/fixtures/native-direct-edit.json")).unwrap();
+    for case in fixture["cases"].as_array().unwrap() {
+        let updates: Vec<SessionUpdate> = serde_json::from_value(case["updates"].clone()).unwrap();
+        let (provider, agent, _) =
+            scripted_provider(0, StopReason::EndTurn, false, false, updates).await;
+        let mut stream = provider
+            .stream_events(
+                &ModelConfig::new("current"),
+                "",
+                &[Message::user().with_text("offline adapter fixture")],
+                &[],
+            )
+            .await
+            .unwrap();
+        let mut terminal = None;
+        timeout(Duration::from_secs(10), async {
+            while let Some(event) = stream.next().await {
+                if let ProviderEvent::NativeTerminal(e) = event.unwrap() {
+                    terminal = Some(e);
+                }
+            }
+        })
+        .await
+        .unwrap();
+        let evidence = terminal.unwrap();
+        assert_eq!(
+            serde_json::to_value(evidence.tool_observation).unwrap(),
+            case["observation"],
+            "{}",
+            case["name"]
+        );
+        let schema = serde_json::json!({"type":"object","properties":{"success":{"type":"boolean"},"summary":{"type":"string"}},"required":["success","summary"],"additionalProperties":false});
+        let accepted = super::validate(&evidence, &schema).is_ok();
+        assert_eq!(
+            accepted,
+            case["accepted"].as_bool().unwrap(),
+            "{} evidence={:?}",
+            case["name"],
+            evidence
+        );
+        drop(provider);
+        agent.abort();
+    }
+}

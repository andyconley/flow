+use crate::providers::base::NativeTurnEvidence;
+use crate::session::Session;
+use anyhow::{bail, Result};
+use serde::de::{self, Deserialize, Deserializer, MapAccess, SeqAccess, Visitor};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::fmt;
+
+pub(crate) const RECEIPT: &str = "native_completion";
+
+pub(crate) fn binding(session: &Session) -> String {
+    let bytes = serde_json::to_vec(&(
+        "native-completion/4",
+        &session.id,
+        &session.recipe,
+        &session.provider_name,
+        &session.model_config,
+        &session.working_dir,
+        &session.goose_mode,
+        session
+            .extension_data
+            .get_extension_state("enabled_extensions", "v0"),
+    ))
+    .expect("session contract serializes");
+    Sha256::digest(bytes)
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+pub(crate) fn output_digest(output: &str) -> String {
+    Sha256::digest(output.as_bytes())
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+pub(crate) fn saved_result(session: &Session) -> Option<Result<String, String>> {
+    let receipt = session.extension_data.get_extension_state(RECEIPT, "v0")?;
+    if receipt.get("binding")?.as_str()? != binding(session) {
+        return Some(Err(
+            "Native completion contract changed; reconciliation required".into(),
+        ));
+    }
+    Some(match receipt.get("error").and_then(Value::as_str) {
+        Some(error) => Err(error.to_owned()),
+        None => match receipt.get("output").and_then(Value::as_str) {
+            Some(output)
+                if receipt.get("output_digest").and_then(Value::as_str)
+                    == Some(output_digest(output).as_str()) =>
+            {
+                Ok(output.to_owned())
+            }
+            _ => Err(
+                "Native receipt result digest is missing or mismatched; reconciliation required"
+                    .into(),
+            ),
+        },
+    })
+}
+
+pub(crate) fn validate(evidence: &NativeTurnEvidence, schema: &Value) -> Result<Value> {
+    if evidence.attempt_id.is_empty() || evidence.provider_session_id.is_empty() {
+        bail!("Native terminal identity is missing");
+    }
+    if evidence.stop_reason != "end_turn" {
+        bail!(
+            "Native turn stopped with {}; effects may be partial",
+            evidence.stop_reason
+        );
+    }
+    if evidence.tool_observation == goose_providers::base::NativeToolObservation::ObservedFailure {
+        bail!("Native tool execution reported failure; effects may be partial");
+    }
+    if evidence.final_message_phase.as_deref() == Some("commentary") {
+        bail!("Native final candidate is commentary, not a final answer");
+    }
+    if evidence.tool_error {
+        bail!("Native tool execution reported failure; effects may be partial");
+    }
+    if evidence.final_text.len() > 65536 {
+        bail!("Native final response exceeds 64 KiB");
+    }
+    depth(schema, 0)?;
+    reject_external_refs(schema)?;
+    let text = evidence.final_text.trim();
+    let text = if let Some(fenced) = text.strip_prefix("```json\n") {
+        fenced
+            .strip_suffix("```")
+            .ok_or_else(|| anyhow::anyhow!("Unclosed JSON fence"))?
+            .trim()
+    } else {
+        text
+    };
+    let mut parser = serde_json::Deserializer::from_str(text);
+    let StrictValue(value) = StrictValue::deserialize(&mut parser)?;
+    parser.end()?;
+    depth(&value, 0)?;
+    check_numbers(text)?;
+    crate::agents::final_output_tool::validate_schema_output(schema, &value)
+        .map_err(anyhow::Error::msg)?;
+    if value.get("success").and_then(Value::as_bool) == Some(false)
+        || value.get("verified").and_then(Value::as_bool) == Some(false)
+    {
+        bail!("Native report explicitly indicates unsuccessful work; inspect retained report");
+    }
+    Ok(value)
+}
+
+fn reject_external_refs(value: &Value) -> Result<()> {
+    match value {
+        Value::Object(map) => {
+            for (key, value) in map {
+                if matches!(key.as_str(), "$ref" | "$dynamicRef")
+                    && value.as_str().is_some_and(|s| !s.starts_with('#'))
+                {
+                    bail!("External schema references are unsupported for native completion");
+                }
+                reject_external_refs(value)?;
+            }
+        }
+        Value::Array(array) => {
+            for value in array {
+                reject_external_refs(value)?;
+            }
+        }
+        _ => (),
+    }
+    Ok(())
+}
+
+fn depth(value: &Value, level: usize) -> Result<()> {
+    if level > 64 {
+        bail!("Native JSON nesting exceeds 64");
+    }
+    match value {
+        Value::Object(map) => {
+            for value in map.values() {
+                depth(value, level + 1)?;
+            }
+        }
+        Value::Array(array) => {
+            for value in array {
+                depth(value, level + 1)?;
+            }
+        }
+        _ => (),
+    }
+    Ok(())
+}
+
+fn decimal(token: &str) -> Result<(bool, String, i64)> {
+    let negative = token.starts_with('-');
+    let token = token.trim_start_matches('-');
+    let (mantissa, exponent) = token.split_once(['e', 'E']).unwrap_or((token, "0"));
+    let mut exponent: i64 = exponent.parse()?;
+    let fractional = mantissa
+        .split_once('.')
+        .map_or(0, |(_, fraction)| fraction.len());
+    exponent -= fractional as i64;
+    let mut digits = mantissa.replace('.', "").trim_start_matches('0').to_owned();
+    while digits.ends_with('0') {
+        digits.pop();
+        exponent += 1;
+    }
+    if digits.is_empty() {
+        return Ok((false, "0".into(), 0));
+    }
+    Ok((negative, digits, exponent))
+}
+
+fn check_numbers(text: &str) -> Result<()> {
+    let bytes = text.as_bytes();
+    let mut index = 0;
+    let mut quoted = false;
+    while index < bytes.len() {
+        match bytes[index] {
+            b'\\' if quoted => {
+                index += 2;
+                continue;
+            }
+            b'"' => quoted = !quoted,
+            b'-' | b'0'..=b'9' if !quoted => {
+                let start = index;
+                while index < bytes.len()
+                    && matches!(bytes[index], b'0'..=b'9' | b'-' | b'+' | b'.' | b'e' | b'E')
+                {
+                    index += 1;
+                }
+                let token = text
+                    .get(start..index)
+                    .ok_or_else(|| anyhow::anyhow!("Invalid native number boundary"))?;
+                let number: serde_json::Number = token.parse()?;
+                if decimal(token)? != decimal(&number.to_string())? {
+                    bail!("Native JSON number cannot be normalized without precision loss");
+                }
+                continue;
+            }
+            _ => (),
+        }
+        index += 1;
+    }
+    Ok(())
+}
+
+struct StrictValue(Value);
+impl<'de> Deserialize<'de> for StrictValue {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct StrictVisitor;
+        impl<'de> Visitor<'de> for StrictVisitor {
+            type Value = StrictValue;
+            fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+                f.write_str("one JSON value without duplicate keys")
+            }
+            fn visit_bool<E: de::Error>(self, v: bool) -> Result<Self::Value, E> {
+                Ok(StrictValue(v.into()))
+            }
+            fn visit_i64<E: de::Error>(self, v: i64) -> Result<Self::Value, E> {
+                Ok(StrictValue(v.into()))
+            }
+            fn visit_u64<E: de::Error>(self, v: u64) -> Result<Self::Value, E> {
+                Ok(StrictValue(v.into()))
+            }
+            fn visit_f64<E: de::Error>(self, v: f64) -> Result<Self::Value, E> {
+                serde_json::Number::from_f64(v)
+                    .map(|n| StrictValue(Value::Number(n)))
+                    .ok_or_else(|| E::custom("Nonfinite number"))
+            }
+            fn visit_str<E: de::Error>(self, v: &str) -> Result<Self::Value, E> {
+                Ok(StrictValue(v.into()))
+            }
+            fn visit_string<E: de::Error>(self, v: String) -> Result<Self::Value, E> {
+                Ok(StrictValue(v.into()))
+            }
+            fn visit_unit<E: de::Error>(self) -> Result<Self::Value, E> {
+                Ok(StrictValue(Value::Null))
+            }
+            fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<Self::Value, A::Error> {
+                let mut values = Vec::new();
+                while let Some(StrictValue(value)) = seq.next_element()? {
+                    values.push(value);
+                }
+                Ok(StrictValue(Value::Array(values)))
+            }
+            fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Self::Value, A::Error> {
+                let mut values = serde_json::Map::new();
+                while let Some(key) = map.next_key::<String>()? {
+                    if values.contains_key(&key) {
+                        return Err(de::Error::custom("Duplicate JSON key"));
+                    }
+                    let StrictValue(value) = map.next_value()?;
+                    values.insert(key, value);
+                }
+                Ok(StrictValue(Value::Object(values)))
+            }
+        }
+        deserializer.deserialize_any(StrictVisitor)
+    }
+}
+

diff --git a/crates/goose/tests/native_completion_protocol_test.rs b/crates/goose/tests/native_completion_protocol_test.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f9594d1450f969aeb9e798303694e50ebf174d5e
--- /dev/null
+++ b/crates/goose/tests/native_completion_protocol_test.rs
@@ -0,0 +1,274 @@
+use agent_client_protocol::schema::v1::{
+    CancelNotification, ContentBlock, ContentChunk, InitializeRequest, InitializeResponse,
+    NewSessionRequest, NewSessionResponse, PromptRequest, PromptResponse, SessionNotification,
+    SessionUpdate, StopReason,
+};
+use agent_client_protocol::schema::ProtocolVersion;
+use agent_client_protocol::{on_receive_notification, on_receive_request, Agent, ByteStreams};
+use futures::StreamExt;
+use goose::acp::{AcpProvider, AcpProviderConfig};
+use goose::config::GooseMode;
+use goose::providers::base::{Provider, ProviderEvent};
+use goose_providers::conversation::message::Message;
+use goose_providers::model::ModelConfig;
+use std::collections::HashMap;
+use std::sync::Arc;
+use tokio::sync::Notify;
+use tokio::time::{timeout, Duration};
+use tokio_util::compat::{TokioAsyncReadCompatExt, TokioAsyncWriteCompatExt};
+
+async fn scripted_provider(
+    chunks: usize,
+    reason: StopReason,
+    wait_cancel: bool,
+    ignore_cancel: bool,
+    updates: Vec<SessionUpdate>,
+) -> (AcpProvider, tokio::task::JoinHandle<()>, Arc<Notify>) {
+    let (client_read, agent_write) = tokio::io::duplex(4096);
+    let (agent_read, client_write) = tokio::io::duplex(4096);
+    let cancelled = Arc::new(Notify::new());
+    let cancel_signal = cancelled.clone();
+    let waiter = cancelled.clone();
+    let agent = tokio::spawn(async move {
+        let _ = Agent
+            .builder()
+            .name("native-fixture")
+            .on_receive_request(
+                async |_req: InitializeRequest, responder, _cx| {
+                    responder.respond(InitializeResponse::new(ProtocolVersion::LATEST))
+                },
+                on_receive_request!(),
+            )
+            .on_receive_request(
+                async |_req: NewSessionRequest, responder, _cx| {
+                    responder.respond(NewSessionResponse::new("native-fixture-session"))
+                },
+                on_receive_request!(),
+            )
+            .on_receive_notification(
+                async move |_req: CancelNotification, _cx| {
+                    cancel_signal.notify_waiters();
+                    Ok(())
+                },
+                on_receive_notification!(),
+            )
+            .on_receive_request(
+                async move |req: PromptRequest, responder, cx| {
+                    let connection = cx.clone();
+                    let waiter = waiter.clone();
+                    let updates = updates.clone();
+                    cx.spawn(async move {
+                        for _ in 0..chunks {
+                            connection.send_notification(SessionNotification::new(
+                                req.session_id.clone(),
+                                SessionUpdate::AgentMessageChunk(ContentChunk::new(
+                                    ContentBlock::Text(
+                                        agent_client_protocol::schema::v1::TextContent::new("x"),
+                                    ),
+                                )),
+                            ))?;
+                        }
+                        for update in updates {
+                            connection.send_notification(SessionNotification::new(
+                                req.session_id.clone(),
+                                update,
+                            ))?;
+                        }
+                        if wait_cancel {
+                            if ignore_cancel {
+                                std::future::pending::<()>().await;
+                            }
+                            waiter.notified().await;
+                        }
+                        responder.respond(PromptResponse::new(reason))
+                    })?;
+                    Ok(())
+                },
+                on_receive_request!(),
+            )
+            .connect_to(ByteStreams::new(
+                agent_write.compat_write(),
+                agent_read.compat(),
+            ))
+            .await;
+    });
+    let config = AcpProviderConfig {
+        native_completion: true,
+        command: "unused".into(),
+        args: vec![],
+        env: vec![],
+        env_remove: vec![],
+        work_dir: std::env::temp_dir(),
+        mcp_servers: vec![],
+        session_mode_id: None,
+        session_config_options: vec![],
+        model_config_option_id: None,
+        mode_mapping: HashMap::new(),
+        notification_callback: None,
+    };
+    let provider = AcpProvider::connect_with_transport(
+        "fixture-acp".into(),
+        GooseMode::Auto,
+        config,
+        ByteStreams::new(client_write.compat_write(), client_read.compat()),
+    )
+    .await
+    .unwrap();
+    (provider, agent, cancelled)
+}
+
+#[tokio::test]
+async fn native_completion_protocol_preserves_terminal_and_saturated_chunks() {
+    let (provider, agent, _) =
+        scripted_provider(256, StopReason::EndTurn, false, false, vec![]).await;
+    let model = ModelConfig::new("current");
+    let mut stream = provider
+        .stream_events(&model, "", &[Message::user().with_text("fixture")], &[])
+        .await
+        .unwrap();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let mut text = String::new();
+    let mut terminal = None;
+    timeout(Duration::from_secs(10), async {
+        while let Some(event) = stream.next().await {
+            match event.unwrap() {
+                ProviderEvent::Chunk(Some(message), _) => text.push_str(&message.as_concat_text()),
+                ProviderEvent::NativeTerminal(evidence) => {
+                    assert!(terminal.is_none());
+                    terminal = Some(evidence);
+                }
+                _ => (),
+            }
+        }
+    })
+    .await
+    .unwrap();
+    let terminal = terminal.expect("terminal evidence");
+    assert_eq!(terminal.stop_reason, "end_turn");
+    assert_eq!(text.len(), 256);
+    assert_eq!(terminal.final_text, text);
+    drop(provider);
+    agent.abort();
+}
+
+#[tokio::test]
+async fn native_completion_protocol_retains_non_success_reason() {
+    let (provider, agent, _) =
+        scripted_provider(1, StopReason::MaxTokens, false, false, vec![]).await;
+    let model = ModelConfig::new("current");
+    let mut stream = provider
+        .stream_events(&model, "", &[Message::user().with_text("fixture")], &[])
+        .await
+        .unwrap();
+    let mut reason = None;
+    timeout(Duration::from_secs(10), async {
+        while let Some(event) = stream.next().await {
+            if let ProviderEvent::NativeTerminal(e) = event.unwrap() {
+                reason = Some(e.stop_reason);
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(reason.as_deref(), Some("max_tokens"));
+    drop(provider);
+    agent.abort();
+}
+
+#[tokio::test]
+async fn native_completion_protocol_stream_drop_sends_cancel() {
+    let (provider, agent, cancelled) =
+        scripted_provider(1, StopReason::Cancelled, true, false, vec![]).await;
+    let observed = cancelled.notified();
+    tokio::pin!(observed);
+    observed.as_mut().enable();
+    let model = ModelConfig::new("current");
+    let mut stream = provider
+        .stream_events(&model, "", &[Message::user().with_text("fixture")], &[])
+        .await
+        .unwrap();
+    assert!(timeout(Duration::from_secs(5), stream.next())
+        .await
+        .unwrap()
+        .is_some());
+    drop(stream);
+    timeout(Duration::from_secs(5), observed)
+        .await
+        .expect("remote receives cancellation");
+    drop(provider);
+    agent.abort();
+}
+
+#[tokio::test]
+async fn native_completion_protocol_cancel_timeout_quarantines_connection() {
+    let (provider, agent, cancelled) =
+        scripted_provider(1, StopReason::Cancelled, true, true, vec![]).await;
+    let observed = cancelled.notified();
+    tokio::pin!(observed);
+    observed.as_mut().enable();
+    let model = ModelConfig::new("current");
+    let mut stream = provider
+        .stream_events(&model, "", &[Message::user().with_text("fixture")], &[])
+        .await
+        .unwrap();
+    assert!(timeout(Duration::from_secs(5), stream.next())
+        .await
+        .unwrap()
+        .is_some());
+    drop(stream);
+    timeout(Duration::from_secs(5), observed).await.unwrap();
+    tokio::time::sleep(Duration::from_millis(5200)).await;
+    assert!(provider
+        .stream_events(
+            &model,
+            "",
+            &[Message::user().with_text("must not replay")],
+            &[]
+        )
+        .await
+        .is_err());
+    drop(provider);
+    agent.abort();
+}
+
+#[tokio::test]
+async fn native_completion_protocol_preserves_message_boundaries_and_unobservable_status() {
+    for unknown in [false, true] {
+        let updates = vec![
+            serde_json::from_value(serde_json::json!({"sessionUpdate":"agent_message_chunk","messageId":"comment","content":{"type":"text","text":"I will update."},"_meta":{"goose.native.messagePhase":"commentary"}})).unwrap(),
+            serde_json::from_value(serde_json::json!({"sessionUpdate":"tool_call","toolCallId":"exec","title":"native execution","kind":"other","status":"completed","rawOutput":if unknown {serde_json::json!({"goose.native.toolObservation":"unobservable"})} else {serde_json::json!({"success":true})}})).unwrap(),
+            serde_json::from_value(serde_json::json!({"sessionUpdate":"agent_message_chunk","messageId":"final","content":{"type":"text","text":"{\"success\":true,\"summary\":\"done\"}"},"_meta":{"goose.native.messagePhase":"final_answer"}})).unwrap(),
+        ];
+        let (provider, agent, _) =
+            scripted_provider(0, StopReason::EndTurn, false, false, updates).await;
+        let model = ModelConfig::new("current");
+        let mut stream = provider
+            .stream_events(&model, "", &[Message::user().with_text("fixture")], &[])
+            .await
+            .unwrap();
+        let mut terminal = None;
+        while let Some(event) = stream.next().await {
+            if let ProviderEvent::NativeTerminal(e) = event.unwrap() {
+                terminal = Some(e);
+            }
+        }
+        let e = terminal.unwrap();
+        assert_eq!(e.final_message_id.as_deref(), Some("final"));
+        assert_eq!(e.final_message_phase.as_deref(), Some("final_answer"));
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&e.final_text).unwrap()["success"],
+            true
+        );
+        assert!(!e.tool_error);
+        assert_eq!(
+            e.tool_observation,
+            if unknown {
+                goose_providers::base::NativeToolObservation::Unobservable
+            } else {
+                goose_providers::base::NativeToolObservation::ObservedSuccess
+            }
+        );
+        drop(provider);
+        agent.abort();
+    }
+}

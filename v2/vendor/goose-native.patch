+#[tokio::test]
+async fn native_boundary_transport_stops_on_explicit_error_before_terminal() {
+    let raw = serde_json::json!({
+        "exit_code": 1,
+        "output": "PermissionError: [Errno 1] Operation not permitted: '/fixture/.venv/pyvenv.cfg'",
+        "goose.native.boundary": {"kind":"permission_required","code":"EPERM",
+            "message":"PermissionError: [Errno 1] Operation not permitted: '/fixture/.venv/pyvenv.cfg'"}
+    });
+    let updates: Vec<SessionUpdate> = serde_json::from_value(serde_json::json!([
+        {"sessionUpdate":"tool_call","toolCallId":"denied-1","title":"python check","kind":"execute","status":"in_progress"},
+        {"sessionUpdate":"tool_call_update","toolCallId":"denied-1","status":"failed","rawOutput":raw}
+    ])).unwrap();
+    let (provider, agent, cancelled) =
+        scripted_provider(0, StopReason::EndTurn, true, false, updates).await;
+    let mut stream = provider
+        .stream_events(
+            &ModelConfig::new("current"),
+            "",
+            &[Message::user().with_text("offline denial regression")],
+            &[],
+        )
+        .await
+        .unwrap();
+    let error = timeout(Duration::from_secs(10), async {
+        while let Some(event) = stream.next().await {
+            match event {
+                Err(error) => return error.to_string(),
+                Ok(ProviderEvent::NativeTerminal(_)) => {
+                    panic!("denial continued to normal terminal")
+                }
+                _ => (),
+            }
+        }
+        panic!("explicit denial was lost")
+    })
+    .await
+    .unwrap();
+    assert!(error.contains(crate::agents::native_boundary::PREFIX));
+    assert!(error.contains("pyvenv.cfg"));
+    assert!(error.contains("EPERM"));
+    let cancellation = cancelled.notified();
+    tokio::pin!(cancellation);
+    cancellation.as_mut().enable();
+    drop(stream);
+    timeout(Duration::from_secs(10), cancellation)
+        .await
+        .unwrap();
+    agent.abort();
+}

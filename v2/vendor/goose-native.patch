+use crate::acp::{AcpProvider, AcpProviderConfig};
+use crate::config::GooseMode;
+use crate::providers::base::{Provider, ProviderEvent};
+use agent_client_protocol::schema::v1::{
+    CancelNotification, ContentBlock, ContentChunk, InitializeRequest, InitializeResponse,
+    NewSessionRequest, NewSessionResponse, PromptRequest, PromptResponse, SessionNotification,
+    SessionUpdate, StopReason,
+};
+use agent_client_protocol::schema::ProtocolVersion;
+use agent_client_protocol::{on_receive_notification, on_receive_request, Agent, ByteStreams};
+use futures::StreamExt;
+use goose_providers::conversation::message::Message;
+use goose_providers::model::ModelConfig;
+use std::collections::HashMap;
+use std::sync::Arc;
+use tokio::sync::Notify;
+use tokio::time::{timeout, Duration};
+use tokio_util::compat::{TokioAsyncReadCompatExt, TokioAsyncWriteCompatExt};
+
+async fn scripted_provider(
+    chunks: usize,
+    reason: StopReason,
+    wait_cancel: bool,
+    ignore_cancel: bool,
+    updates: Vec<SessionUpdate>,
+) -> (AcpProvider, tokio::task::JoinHandle<()>, Arc<Notify>) {
+    let (client_read, agent_write) = tokio::io::duplex(4096);
+    let (agent_read, client_write) = tokio::io::duplex(4096);
+    let cancelled = Arc::new(Notify::new());
+    let cancel_signal = cancelled.clone();
+    let waiter = cancelled.clone();
+    let agent = tokio::spawn(async move {
+        let _ = Agent
+            .builder()
+            .name("native-fixture")
+            .on_receive_request(
+                async |_req: InitializeRequest, responder, _cx| {
+                    responder.respond(InitializeResponse::new(ProtocolVersion::LATEST))
+                },
+                on_receive_request!(),
+            )
+            .on_receive_request(
+                async |_req: NewSessionRequest, responder, _cx| {
+                    responder.respond(NewSessionResponse::new("native-fixture-session"))
+                },
+                on_receive_request!(),
+            )
+            .on_receive_notification(
+                async move |_req: CancelNotification, _cx| {
+                    cancel_signal.notify_waiters();
+                    Ok(())
+                },
+                on_receive_notification!(),
+            )
+            .on_receive_request(
+                async move |req: PromptRequest, responder, cx| {
+                    let connection = cx.clone();
+                    let waiter = waiter.clone();
+                    let updates = updates.clone();
+                    cx.spawn(async move {
+                        for _ in 0..chunks {
+                            connection.send_notification(SessionNotification::new(
+                                req.session_id.clone(),
+                                SessionUpdate::AgentMessageChunk(ContentChunk::new(
+                                    ContentBlock::Text(
+                                        agent_client_protocol::schema::v1::TextContent::new("x"),
+                                    ),
+                                )),
+                            ))?;
+                        }
+                        for update in updates {
+                            connection.send_notification(SessionNotification::new(
+                                req.session_id.clone(),
+                                update,
+                            ))?;
+                        }
+                        if wait_cancel {
+                            if ignore_cancel {
+                                std::future::pending::<()>().await;
+                            }
+                            waiter.notified().await;
+                        }
+                        responder.respond(PromptResponse::new(reason))
+                    })?;
+                    Ok(())
+                },
+                on_receive_request!(),
+            )
+            .connect_to(ByteStreams::new(
+                agent_write.compat_write(),
+                agent_read.compat(),
+            ))
+            .await;
+    });
+    let config = AcpProviderConfig {
+        native_completion: true,
+        command: "unused".into(),
+        args: vec![],
+        env: vec![],
+        env_remove: vec![],
+        work_dir: std::env::temp_dir(),
+        mcp_servers: vec![],
+        session_mode_id: None,
+        session_config_options: vec![],
+        model_config_option_id: None,
+        mode_mapping: HashMap::new(),
+        notification_callback: None,
+    };
+    let provider = AcpProvider::connect_with_transport(
+        "fixture-acp".into(),
+        GooseMode::Auto,
+        config,
+        ByteStreams::new(client_write.compat_write(), client_read.compat()),
+    )
+    .await
+    .unwrap();
+    (provider, agent, cancelled)
+}
